# Compose reads these values from this file. PostgreSQL credentials go to all
# three services; local Ollama endpoint/model settings go only to FastAPI.
# Do not also define DATABASE_URL; the app rejects mixed configuration sources.
POSTGRES_DB=privacy_audit
POSTGRES_USER=privacy_audit
POSTGRES_PASSWORD=replace_with_a_long_random_password
APP_PORT=8767
# Optional AI analysis uses only the local Ollama HTTP service; no API key is used.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
